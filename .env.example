# Find Your Fit backend. Leave all of these unset and the site behaves as before: measuring works on the phone
# with no gate, the studio says it is not connected, and try-on stays hidden.

# Supabase (all four are needed). The service role key and FIT_TOKEN_SECRET are server-only: never prefix them
# with NEXT_PUBLIC_. Apply supabase/migrations/ to the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# At least 16 characters, random. Signs the token on each customer's phone. Changing it signs everyone out of
# the gate (they simply fill it in again). Generate with: openssl rand -base64 32
FIT_TOKEN_SECRET=

# Try-on (Gemini image editing). Leave off until docs/FIT-SPIKE-REPORT.md says go.
FIT_TRYON_ENABLED=
# Set to true only when GEMINI_API_KEY belongs to a billing-enabled Google AI project. On the unpaid tier Google
# may use and review uploaded photos, so the route refuses to run without this.
GEMINI_PAID_TIER_CONFIRMED=
GEMINI_API_KEY=
# The model the spike chose, for example gemini-3.1-flash-image or gemini-3-pro-image.
GEMINI_IMAGE_MODEL=
# Previews per phone per day (default 6) and per studio staff member per day (default 30).
FIT_TRYON_DAILY_CAP=
FIT_STUDIO_DAILY_CAP=
# Previews across the whole site per India day (default 150): the spending brake if many phones join at once.
FIT_TRYON_GLOBAL_DAILY_CAP=

# Local development only, refused in production: an in-memory backend and a fake try-on that returns the
# catalogue photo, so the whole journey runs without keys. Playwright sets these itself.
# FIT_BACKEND=memory
# FIT_TRYON_PROVIDER=fake
# STUDIO_DEV_EMAIL=studio@example.com
# STUDIO_DEV_PASSWORD=choose-a-local-password
